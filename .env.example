# Local / deployment placeholders. Never commit real values.
# Copy to a private file outside Git (e.g. .local/runtime.env) with mode 600.

# Data directory for SQLite + asset storage (created by wardrobectl init-db).
WARDROBE_DATA_ROOT=.local/wardrobe

# Default IANA timezone for recommendation locations that omit a timezone.
WARDROBE_TIMEZONE=UTC

# Comma-separated Host header allowlist. Production must set your real host.
WARDROBE_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Browser Origins if needed (default empty = no browser CORS).
# WARDROBE_ALLOWED_ORIGINS=

# Audience string for bearer grants.
WARDROBE_AUDIENCE=wardrobe-local

# Feature flags (keep agent entry disabled unless you intend to enable it).
WARDROBE_AGENT_ENABLED=false
WARDROBE_INTAKE_ENABLED=false

# Optional third-party integrations (files must be mode 600, outside Git).
# WARDROBE_MODEL_CREDENTIALS_FILE=.local/credentials/model.json
# WARDROBE_MODEL_PROVIDER=
# WARDROBE_WEATHER_PROVIDER=open-meteo
