[Unit]
Description=Private wardrobe admin adapter
Requires=wardrobe-admin.socket
After=network.target

[Service]
Type=simple
User=wardrobe-admin
Group=wardrobe-admin
ExecStart=/usr/bin/python3 /opt/wardrobe-admin/proxy.py
Sockets=wardrobe-admin.socket
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
InaccessiblePaths=-/var/lib/open-wardrobe -/etc/nginx/wardrobe-admin.htpasswd
ReadOnlyPaths=/opt/wardrobe-admin /var/lib/wardrobe-admin/ui /etc/wardrobe-admin
MemoryMax=128M
CPUQuota=20%
TasksMax=32
Restart=on-failure
RestartSec=5
